# --- Google Gemini (pick one path) -----------------------------------------
#
# Recommended for hackathon / Cloud Run: Vertex AI (uses your GCP credits).
# Remove or comment out GOOGLE_API_KEY when using Vertex.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
# Use a regional location (e.g. us-central1), not global — global has tighter RPM quota.
GOOGLE_CLOUD_LOCATION=us-central1

# Local fallback: AI Studio key (no billing). Comment out Vertex vars above.
# Get one at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# Model used by the ADK agent (dailies_agent/agent.py) and ingest/parse scripts
AGENT_MODEL=gemini-2.5-flash

# Footage project the agent scopes queries to (default NOTLD demo)
PROJECT_ID=notld_1968

# Base URL for clip watch links the agent cites in answers.
# Run: .venv/Scripts/python.exe -m uvicorn projects_api:app --port 8080
CLIP_BASE_URL=http://127.0.0.1:8080

# --- ClickHouse Cloud (console > your service > Connect) ---------------------
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
# Use a read-only user for the agent when possible; see docs/DEPLOY.md.
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Optional: passed through to mcp-clickhouse (agent subprocess only)
CLICKHOUSE_MCP_QUERY_TIMEOUT=30
