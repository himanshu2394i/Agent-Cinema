# Gemini API - AI Studio key (default path, no cloud project/billing needed)
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Alternative: Vertex AI, if you have a billed Google Cloud project.
# Set these instead of GOOGLE_API_KEY (unused/undeployed on this project).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# ClickHouse Cloud - console > your service > Connect
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Model used by the ADK agent (dailies_agent/agent.py)
AGENT_MODEL=gemini-3.6-flash
